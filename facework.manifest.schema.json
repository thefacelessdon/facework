{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facework.dev/schemas/facework.manifest.schema.json",
  "title": "Facework Manifest",
  "description": "Schema for Facework Protocol v1 project manifests. v1.1.0 adds runtime_ports; v1.2.0 adds HarnessBundle; v1.3.0 adds DesignInfrastructure; v1.4.0 adds optional efficiency hints + skill semantics polish (sponsors, verifier_skill_id, multiplayer, sensors/actuators, cache_affinity, load_mode, intermediate, compactable, model_tier, advisor_escalation). v1.5.0 adds the runtime-conformance tier: runtime_ports.conformance + RuntimeConformanceProfile (PROTOCOL.md §9.2/§9.12); v1.6.0 adds shell_sovereignty.harness_options for multi-harness shells (§9.11/§9.12); v1.7.0 adds waiver.ruling, making the Phase-7 Sovereignty-loop gate enforceable (§9.12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "project",
    "inputs",
    "artifacts",
    "gates",
    "compliance"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "1.0.0 (v0.0.4 baseline), 1.1.0 (v0.0.5 Runtime Ports), 1.2.0 (v0.0.6 HarnessBundle), 1.3.0 (v0.0.7 DesignInfrastructure), 1.4.0 (v0.0.8 efficiency hints + skill polish), 1.5.0 (v0.0.25 runtime-conformance tier), 1.6.0 (v0.0.46 multi-harness shells; v0.0.56 project.manifest_role), 1.7.0 (v0.0.48 enforceable owner ruling), and forward 1.x.x compatible."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain",
        "stage"
      ],
      "properties": {
        "manifest_role": {
          "type": "string",
          "enum": ["tenant", "reference"],
          "default": "tenant",
          "description": "v1.6.0 — 'tenant' (default, and assumed when absent): every artifacts[] path MUST resolve to a real file (PROTOCOL.md §7). 'reference': the manifest illustrates the schema and is NOT a conformance claim; artifact paths are illustrative, validators MUST report the exemption rather than pass silently, and it MUST NOT be cited as evidence of conformance."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "mvp",
            "beta",
            "scale"
          ]
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "validated",
            "signaled",
            "thesis"
          ],
          "description": "Demand evidence level from PROTOCOL.md §3. Calibrates artifact production depth and runtime_ports conformance (Validated=MUST, Signaled=SHOULD, Thesis=MAY-minimal)."
        },
        "track": {
          "type": "string",
          "enum": [
            "creator",
            "cultural_brand",
            "athlete",
            "agency_studio",
            "platform_product"
          ],
          "description": "Project track from PROTOCOL.md §3. Determines track-aware port skeleton defaults."
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "hunch"
      ],
      "properties": {
        "hunch": {
          "type": "string",
          "minLength": 1
        },
        "audience_context": {
          "type": "string"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_thesis",
        "audience_field_map",
        "taste_contract",
        "decision_ledger",
        "wedge_spec",
        "system_architecture",
        "workflow_playbooks",
        "launch_plan",
        "sovereignty_map",
        "diagnostic_report"
      ],
      "properties": {
        "signal_thesis": { "type": "string", "minLength": 1 },
        "audience_field_map": { "type": "string", "minLength": 1 },
        "taste_contract": { "type": "string", "minLength": 1 },
        "decision_ledger": { "type": "string", "minLength": 1 },
        "wedge_spec": { "type": "string", "minLength": 1 },
        "system_architecture": { "type": "string", "minLength": 1 },
        "workflow_playbooks": { "type": "string", "minLength": 1 },
        "launch_plan": { "type": "string", "minLength": 1 },
        "sovereignty_map": { "type": "string", "minLength": 1 },
        "diagnostic_report": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantics",
        "field",
        "taste",
        "strategy",
        "architecture",
        "launch",
        "sovereignty",
        "diagnostic"
      ],
      "properties": {
        "semantics": { "$ref": "#/$defs/gateStatus" },
        "field": { "$ref": "#/$defs/gateStatus" },
        "taste": { "$ref": "#/$defs/gateStatus" },
        "strategy": { "$ref": "#/$defs/gateStatus" },
        "architecture": { "$ref": "#/$defs/gateStatus" },
        "launch": { "$ref": "#/$defs/gateStatus" },
        "sovereignty": { "$ref": "#/$defs/gateStatus" },
        "diagnostic": { "$ref": "#/$defs/gateStatus" }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_integrity",
        "taste_fidelity",
        "system_coherence",
        "operational_readiness",
        "infrastructure_sovereignty",
        "total",
        "level"
      ],
      "properties": {
        "signal_integrity": { "$ref": "#/$defs/score20" },
        "taste_fidelity": { "$ref": "#/$defs/score20" },
        "system_coherence": { "$ref": "#/$defs/score20" },
        "operational_readiness": { "$ref": "#/$defs/score20" },
        "infrastructure_sovereignty": { "$ref": "#/$defs/score20" },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "type": "string",
          "enum": [
            "L0 Draft",
            "L1 Structured",
            "L2 Coherent",
            "L3 Launch-Ready",
            "L4 Sovereign"
          ]
        }
      }
    },
    "runtime_ports": {
      "$ref": "#/$defs/runtimePorts",
      "description": "Optional v1.1.0 block declaring the four runtime port manifest paths. Conformance per evidence_level: Validated=MUST, Signaled=SHOULD, Thesis=MAY (minimal SkillManifest only)."
    },
    "design_infrastructure": {
      "$ref": "#/$defs/designInfrastructureRef",
      "description": "Optional v1.3.0 block declaring tokens, components, examples, and evaluator skill ID. Conformance is track-aware (see PROTOCOL.md §11.7) — Cultural Brand MUST, Creator/Athlete/Platform SHOULD, Agency/Studio MAY."
    }
  },
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "score20": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "runtimePorts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills":      { "$ref": "#/$defs/runtimePortRef" },
        "memory":      { "$ref": "#/$defs/runtimePortRef" },
        "context":     { "$ref": "#/$defs/runtimePortRef" },
        "connections": { "$ref": "#/$defs/runtimePortRef" },
        "bundle":      { "$ref": "#/$defs/harnessBundleRef" },
        "conformance": { "$ref": "#/$defs/runtimeConformanceRef" }
      }
    },
    "harnessBundleRef": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the harness-bundle/ directory (v1.2.0)."
        },
        "cache_affinity": {
          "type": "string",
          "enum": ["stable", "dynamic"],
          "default": "stable",
          "description": "v1.4.0 — Cache affinity hint for the bundle. Default 'stable'."
        }
      }
    },
    "designInfrastructureRef": {
      "type": "object",
      "required": ["tokens", "components", "examples", "evaluator_skill_id"],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to tokens.json (or .yaml)."
        },
        "components": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to components.yaml."
        },
        "examples": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the examples/ directory."
        },
        "evaluator_skill_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Skill ID in SkillManifest that implements the design-eye evaluator."
        }
      }
    },
    "runtimePortRef": {
      "type": "object",
      "required": ["manifest"],
      "additionalProperties": true,
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the port manifest YAML file."
        },
        "cache_affinity": {
          "type": "string",
          "enum": ["stable", "dynamic"],
          "default": "stable",
          "description": "v1.4.0 — Cache affinity hint for the entire port manifest. Default 'stable'."
        }
      }
    },

    "runtimeConformanceRef": {
      "type": "object",
      "required": ["claimed"],
      "additionalProperties": false,
      "description": "v1.5.0 — Opt-in runtime-conformance claim (PROTOCOL.md §9.2). Omitting this block, or claimed:false, leaves the project at evidence-calibrated base conformance and changes nothing.",
      "properties": {
        "claimed": {
          "type": "boolean",
          "description": "When true, the §9.2 runtime-conformance MUSTs apply regardless of evidence_level: all four port manifests emitted and valid, all cross-manifest references (§9.7) resolve, and a valid RuntimeConformanceProfile is present."
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "description": "Label of the target runtime shell (free-form, e.g. 'claude-code', 'buzz', 'letta'). REQUIRED when claimed is true."
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the RuntimeConformanceProfile YAML. REQUIRED when claimed is true; MUST resolve to a valid #/$defs/runtimeConformanceProfile."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "claimed": { "const": true } }, "required": ["claimed"] },
          "then": { "required": ["claimed", "runtime", "profile"] }
        }
      ]
    },

    "runtimeConformanceProfile": {
      "type": "object",
      "required": ["version", "tenant", "runtime", "port_bindings", "shell_sovereignty", "governance"],
      "additionalProperties": false,
      "description": "v1.5.0 — Declares HOW a tenant world satisfies the Runtime Ports on a specific runtime shell (PROTOCOL.md §9.12). The machine record of what §9.11 describes in prose; formalized from the FS-400 concepts validated across four reference runtimes.",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$",
          "description": "Manifest schema version this profile targets (1.5.0+)."
        },
        "tenant": { "type": "string", "minLength": 1 },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "description": "Label of the target runtime shell. SHOULD match runtime_ports.conformance.runtime."
        },
        "port_bindings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "One entry per port. All four ports MUST be covered when runtime conformance is claimed (§9.12 Phase-5 gate).",
          "items": { "$ref": "#/$defs/runtimePortBinding" }
        },
        "shell_sovereignty": { "$ref": "#/$defs/shellSovereignty" },
        "governance": {
          "type": "array",
          "description": "FS-400.4 — one entry per governance attribute the project relies on.",
          "items": { "$ref": "#/$defs/governanceBinding" }
        }
      }
    },

    "runtimePortBinding": {
      "type": "object",
      "required": ["port", "status", "mechanism"],
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "string",
          "enum": ["skills", "memory", "context", "connections"]
        },
        "status": {
          "type": "string",
          "enum": ["native", "partial", "authoring_side"],
          "description": "native = the runtime hosts the port directly; partial = hosted with declared gaps; authoring_side = not hosted, stays in the Facework manifest."
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "The runtime primitive that hosts the port (e.g. 'claude-code:.claude/skills'), or 'authoring-layer' when status is authoring_side."
        },
        "notes": { "type": "string" }
      }
    },

    "shellSovereignty": {
      "type": "object",
      "required": ["harness", "state", "model"],
      "additionalProperties": false,
      "description": "FS-400.6 + FS-400.7 — shell sovereignty decomposed by layer. A fully self-hostable shell (all layers 'own') omits waiver. v1.6.0 adds harness_options for multi-harness shells (§9.11).",
      "properties": {
        "harness": { "$ref": "#/$defs/sovereigntyPosture" },
        "state": { "$ref": "#/$defs/sovereigntyPosture" },
        "model": { "$ref": "#/$defs/sovereigntyPosture" },
        "harness_options": {
          "type": "array",
          "minItems": 2,
          "description": "v1.6.0 (optional) — for a MULTI-HARNESS shell, the agent loops it can bind, each with its own posture. The loop is selected per invocation, so 'harness' above classifies the shell itself while these classify what it can run (PROTOCOL.md §9.11).",
          "items": {
            "type": "object",
            "required": ["harness", "posture"],
            "additionalProperties": false,
            "properties": {
              "harness": { "type": "string", "minLength": 1, "description": "Runtime label of the selectable agent loop (e.g. 'claude-code', 'goose')." },
              "posture": { "$ref": "#/$defs/sovereigntyPosture" },
              "notes": { "type": "string" }
            }
          }
        },
        "waiver": { "$ref": "#/$defs/sovereigntyWaiver" }
      },
      "anyOf": [
        {
          "properties": {
            "harness": { "const": "own" },
            "state": { "const": "own" },
            "model": { "const": "own" }
          }
        },
        { "required": ["waiver"] }
      ]
    },

    "sovereigntyPosture": {
      "type": "string",
      "enum": ["own", "rent", "mitigate"],
      "description": "Sovereignty posture for one shell layer — harness (the agent loop), state (memory, config, transcripts), or model (the LLM)."
    },

    "sovereigntyWaiver": {
      "type": "object",
      "required": ["layers", "exit_plan", "data_posture"],
      "additionalProperties": false,
      "description": "REQUIRED if any shell_sovereignty layer is 'rent' or 'mitigate'. The Phase-7 gate checks this against a recorded Sovereignty-loop ruling (§9.11). v1.7.0 replaces free-text owner_ruling with the structured ruling object so that gate can actually fail; exactly one of the two must be present.",
      "oneOf": [
        { "required": ["ruling"] },
        { "required": ["owner_ruling"] }
      ],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["harness", "state", "model"] },
          "description": "Which layers this waiver covers. MUST cover every rent/mitigate layer."
        },
        "exit_plan": {
          "type": "string",
          "minLength": 1,
          "description": "Can tenant state relocate? Non-empty is a validation requirement (§9.12)."
        },
        "data_posture": {
          "type": "object",
          "required": ["retention", "training", "residency"],
          "additionalProperties": false,
          "properties": {
            "retention": { "type": "string", "minLength": 1 },
            "training": { "type": "string", "minLength": 1 },
            "residency": { "type": "string", "minLength": 1 }
          }
        },
        "owner_ruling": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "v1.5.0, DEPRECATED in v1.7.0 — free-text 'who ruled, and when'. Still accepted and read as ruling.status='ruled' so every v1.5.0/v1.6.0 profile stays valid. Replaced because free text cannot be gated: the string 'PENDING — no ruling recorded yet' satisfied the Phase-7 check while asserting that check's own condition was unmet. Use `ruling` instead."
        },
        "ruling": { "$ref": "#/$defs/sovereigntyRuling" }
      }
    },

    "sovereigntyRuling": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "description": "v1.7.0 — the recorded Sovereignty-loop decision on a waiver. Structured so the Phase-7 gate is machine-checkable. Per the 0.0.14 guard-rail an agent MAY write status 'pending' and MUST NEVER write 'ruled' on a human's behalf.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ruled", "pending"],
          "description": "'ruled' — a human has decided; requires by + on. 'pending' — no ruling exists yet; by and on MUST be absent. A profile with a pending ruling is valid validation output but MUST NOT be reached through a conformance.claimed:true manifest (§9.2)."
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "Who ruled. REQUIRED when status is 'ruled'; MUST be absent when 'pending'."
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO YYYY-MM-DD date of the ruling. REQUIRED when status is 'ruled'; MUST be absent when 'pending'. Named 'date' rather than 'on' deliberately: YAML 1.1 parses a bare on: key as the boolean true, so 'on' is unusable as a manifest key."
        },
        "note": {
          "type": "string",
          "description": "What was decided, and the reasoning. Optional in both states — for 'pending', a useful place to say what the profile is (e.g. validation output, not an adoption decision)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ruled" } }, "required": ["status"] },
          "then": { "required": ["status", "by", "date"] }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
          "then": { "not": { "anyOf": [ { "required": ["by"] }, { "required": ["date"] } ] } }
        }
      ]
    },

    "governanceBinding": {
      "type": "object",
      "required": ["attribute", "kind"],
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "type": "string",
          "minLength": 1,
          "description": "The manifest field this entry governs (e.g. trust_boundary, verifier_skill_id, escalation, pii, rate_limits, data_residency, sponsors)."
        },
        "kind": {
          "type": "string",
          "enum": ["gate", "metadata"],
          "description": "gate = enforceable, the runtime can act on it; metadata = descriptive, inherently authoring-layer."
        },
        "binds_to": {
          "type": "string",
          "minLength": 1,
          "description": "For kind:gate — the runtime mechanism that enforces it (e.g. 'claude-code:permissions')."
        },
        "unenforced": {
          "type": "boolean",
          "description": "For kind:gate — true when the runtime cannot enforce it, so it is declared and delegated to the authoring layer or human process. NOT a gate failure (§9.11)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "gate" } }, "required": ["kind"] },
          "then": {
            "anyOf": [
              { "required": ["binds_to"] },
              { "properties": { "unenforced": { "const": true } }, "required": ["unenforced"] }
            ]
          }
        }
      ]
    },

    "skillManifest": {
      "type": "object",
      "required": ["version", "tenant", "track", "skills"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "tenant":  { "type": "string", "minLength": 1 },
        "track": {
          "type": "string",
          "enum": ["creator", "cultural_brand", "athlete", "agency_studio", "platform_product"]
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/skill" }
        }
      }
    },
    "skill": {
      "type": "object",
      "required": ["id", "name", "description", "domain", "trigger", "ownership", "playbook"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name":        { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "domain":      { "type": "string", "minLength": 1 },
        "trigger":     { "enum": ["on_demand", "scheduled", "event", "continuous"] },
        "ownership":   { "enum": ["human", "agent", "hybrid"] },
        "playbook":    { "type": "string", "minLength": 1 },
        "inputs":      { "type": "array", "items": { "$ref": "#/$defs/skillParameter" } },
        "outputs":     { "type": "array", "items": { "$ref": "#/$defs/skillOutput" } },
        "depends_on_capabilities": { "type": "array", "items": { "type": "string" } },
        "reads_memory":  { "type": "array", "items": { "type": "string" } },
        "writes_memory": { "type": "array", "items": { "type": "string" } },
        "context_load":  { "type": "array", "items": { "type": "string" } },
        "integrations":  { "type": "array", "items": { "type": "string" } },
        "escalation":    { "type": "string" },
        "schedule":      { "type": "string" },
        "event": {
          "type": "object",
          "required": ["name", "source"],
          "properties": {
            "name":   { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sponsors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "v1.4.0 — Human(s) accountable for the skill's correctness, memory hygiene, and lifecycle. SHOULD be populated on Validated-evidence projects."
        },
        "verifier_skill_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "v1.4.0 — ID of a Skill (in the same manifest) that gates this skill's output before publication. The verifier SHOULD have domain: quality. Generalizes the design-eye-evaluator pattern (PROTOCOL.md §11)."
        },
        "multiplayer": {
          "type": "boolean",
          "default": false,
          "description": "v1.4.0 — When true, the skill may be invoked by multiple users concurrently and memory writes accrue across users. Default false (single-user)."
        },
        "model_tier": {
          "type": "string",
          "enum": ["standard", "advanced"],
          "default": "standard",
          "description": "v1.4.0 — Declares which model tier this skill warrants. Runtimes map 'advanced' to their premium tier (e.g. Opus). Default 'standard'."
        },
        "advisor_escalation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "v1.4.0 — Optional skill_id that this skill can invoke for a one-shot advisor judgment on advanced model_tier. Composable: the escalation goes through a registered Skill, so it gets its own audit trail."
        }
      },
      "allOf": [
        { "if": { "properties": { "trigger": { "const": "scheduled" } } },
          "then": { "required": ["schedule"] } },
        { "if": { "properties": { "trigger": { "const": "event" } } },
          "then": { "required": ["event"] } }
      ]
    },
    "skillParameter": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "minLength": 1 },
        "type":        { "enum": ["string", "number", "boolean", "object", "array", "file_path", "url"] },
        "required":    { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "skillOutput": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "minLength": 1 },
        "type":        { "enum": ["string", "number", "boolean", "object", "array", "file_path", "url"] },
        "write_to":    { "type": "string" },
        "description": { "type": "string" },
        "intermediate": {
          "type": "boolean",
          "default": false,
          "description": "v1.4.0 — When true, the output exists for downstream tool consumption only. Runtimes may keep it out of the operator's context window. Default false (visible)."
        }
      }
    },

    "memoryMap": {
      "type": "object",
      "required": ["version", "tenant", "root", "structure", "boundary"],
      "additionalProperties": false,
      "properties": {
        "version":   { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "tenant":    { "type": "string", "minLength": 1 },
        "root":      { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "structure": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/memoryFolder" } },
        "indexing":  { "type": "array", "items": { "$ref": "#/$defs/memoryIndex" } },
        "boundary":  { "$ref": "#/$defs/memoryBoundary" },
        "retention": { "type": "array", "items": { "$ref": "#/$defs/memoryRetention" } },
        "conventions": { "type": "object", "additionalProperties": true }
      }
    },
    "memoryFolder": {
      "type": "object",
      "required": ["path", "purpose"],
      "additionalProperties": false,
      "properties": {
        "path":       { "type": "string", "minLength": 1 },
        "purpose":    { "type": "string", "minLength": 1 },
        "contains":   { "type": "array", "items": { "type": "string" } },
        "written_by": { "type": "array", "items": { "type": "string" } },
        "read_by":    { "type": "array", "items": { "type": "string" } },
        "children":   { "type": "array", "items": { "$ref": "#/$defs/memoryFolder" } },
        "compactable": {
          "type": "boolean",
          "default": false,
          "description": "v1.4.0 — When true, the folder's contents may be summarized or dropped from in-session context after writing. Content persists on disk. Default false (kept in context)."
        }
      }
    },
    "memoryBoundary": {
      "type": "object",
      "required": ["tenant_memory_root", "runtime_memory_path", "rule"],
      "additionalProperties": false,
      "properties": {
        "tenant_memory_root":  { "type": "string", "minLength": 1 },
        "runtime_memory_path": { "type": "string", "minLength": 1 },
        "rule":                { "type": "string", "minLength": 1 },
        "responsibilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenant_memory":  { "type": "array", "items": { "type": "string" } },
            "runtime_memory": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "memoryIndex": {
      "type": "object",
      "required": ["folder", "tool"],
      "additionalProperties": false,
      "properties": {
        "folder":          { "type": "string", "minLength": 1 },
        "tool":            { "type": "string", "minLength": 1 },
        "scope":           { "enum": ["recursive", "direct"] },
        "refresh":         { "enum": ["on_write", "scheduled", "manual"] },
        "refresh_schedule": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "refresh": { "const": "scheduled" } } },
          "then": { "required": ["refresh_schedule"] } }
      ]
    },
    "memoryRetention": {
      "type": "object",
      "required": ["path", "policy"],
      "additionalProperties": false,
      "properties": {
        "path":   { "type": "string", "minLength": 1 },
        "policy": { "enum": ["keep_forever", "archive_after_days", "delete_after_days", "compress_after_days"] },
        "days":   { "type": "integer", "minimum": 1 },
        "target": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "policy": { "enum": ["archive_after_days", "delete_after_days", "compress_after_days"] } } },
          "then": { "required": ["days"] } }
      ]
    },

    "contextManifest": {
      "type": "object",
      "required": ["version", "tenant", "global", "bundles"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "tenant":  { "type": "string", "minLength": 1 },
        "global":  { "$ref": "#/$defs/contextBundle" },
        "bundles": { "type": "array", "items": { "$ref": "#/$defs/contextBundle" } }
      }
    },
    "contextBundle": {
      "type": "object",
      "required": ["id", "name", "purpose"],
      "additionalProperties": false,
      "properties": {
        "id":         { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" },
        "name":       { "type": "string", "minLength": 1 },
        "purpose":    { "type": "string", "minLength": 1 },
        "load":       { "type": "array", "items": { "$ref": "#/$defs/contextSource" } },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "priority":   { "enum": ["must", "should", "may"] },
        "composes":   { "type": "array", "items": { "type": "string" } },
        "excludes":   { "type": "array", "items": { "type": "string" } },
        "cache_affinity": {
          "type": "string",
          "enum": ["stable", "dynamic"],
          "default": "stable",
          "description": "v1.4.0 — Runtimes implementing prompt caching use this to inform eviction strategy. Default 'stable' (cache aggressively)."
        }
      },
      "anyOf": [
        { "properties": { "load":     { "type": "array", "minItems": 1 } }, "required": ["load"] },
        { "properties": { "composes": { "type": "array", "minItems": 1 } }, "required": ["composes"] }
      ]
    },
    "contextSource": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind":        { "enum": ["file", "query", "live", "section"] },
        "path":        { "type": "string" },
        "query":       { "type": "string" },
        "against":     { "type": "string" },
        "integration": { "type": "string" },
        "section":     { "type": "string" },
        "format":      { "enum": ["markdown", "yaml", "json", "text"] },
        "as":          { "enum": ["system_prompt", "tool_result", "file", "inline"] },
        "description": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "file" } } },
          "then": { "required": ["path"] } },
        { "if": { "properties": { "kind": { "const": "query" } } },
          "then": { "required": ["query", "against"] } },
        { "if": { "properties": { "kind": { "const": "live" } } },
          "then": { "required": ["integration"] } },
        { "if": { "properties": { "kind": { "const": "section" } } },
          "then": { "required": ["path", "section"] } }
      ]
    },

    "integrationManifest": {
      "type": "object",
      "required": ["version", "tenant", "integrations"],
      "additionalProperties": false,
      "properties": {
        "version":      { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "tenant":       { "type": "string", "minLength": 1 },
        "integrations": { "type": "array", "items": { "$ref": "#/$defs/integration" } }
      }
    },
    "integration": {
      "type": "object",
      "required": ["id", "name", "kind", "auth", "trust_boundary", "used_by"],
      "additionalProperties": false,
      "properties": {
        "id":              { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name":            { "type": "string", "minLength": 1 },
        "kind":            { "enum": ["mcp", "rest", "cli", "filesystem", "webhook", "db"] },
        "auth":            { "enum": ["oauth", "api_key", "local", "none", "mtls"] },
        "trust_boundary":  { "enum": ["own", "rent", "mitigate"] },
        "used_by":         { "type": "array", "items": { "type": "string" } },
        "endpoint":        { "type": "string" },
        "scope":           {
          "type": "array",
          "items": { "$ref": "#/$defs/integrationScopeItem" },
          "description": "v1.4.0 — Each item is either a string (operation name, back-compat with v1.0.0–v1.3.0) OR an object {operation, direction}. Mixed forms allowed."
        },
        "secrets":         { "type": "array", "items": { "$ref": "#/$defs/secretRef" } },
        "rate_limits":     { "type": "object", "additionalProperties": true },
        "failover":        { "type": "string" },
        "data_residency":  { "type": "string" },
        "pii":             { "type": "boolean" },
        "description":     { "type": "string" },
        "load_mode": {
          "type": "string",
          "enum": ["eager", "lazy", "on_search"],
          "default": "eager",
          "description": "v1.4.0 — Declares whether the runtime should eagerly load the integration's schema/handles or pull on demand. Default 'eager'. 'on_search' maps to Claude Platform tool-search optimization."
        }
      },
      "allOf": [
        { "if": { "properties": { "pii": { "const": true } } },
          "then": { "required": ["data_residency"] } }
      ]
    },
    "secretRef": {
      "type": "object",
      "required": ["name", "store", "ref"],
      "additionalProperties": false,
      "properties": {
        "name":     { "type": "string", "minLength": 1 },
        "store":    { "type": "string", "minLength": 1 },
        "ref":      { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "integrationScopeItem": {
      "description": "v1.4.0 — Scope items may be either a plain operation string (back-compat) or an object with operation + direction (sensors/actuators framing from Karpathy).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["operation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "type": "string", "minLength": 1 },
            "direction": {
              "type": "string",
              "enum": ["sensor", "actuator", "both"],
              "description": "sensor = reads from external world; actuator = writes/acts on external world; both = bidirectional."
            }
          }
        }
      ]
    }
  }
}
