#!/bin/bash
# Verifies that the Facework skills in ~/.claude/skills resolve to THIS clone.
# Usage: facework-doctor [--quiet]
#   --quiet  print nothing when healthy; print only failures + the fix command.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SKILL_DIR="$HOME/.claude/skills"
MARKER="$SKILL_DIR/.facework-canonical"

QUIET=0
if [ "${1:-}" = "--quiet" ]; then
  QUIET=1
fi

REQUIRED=(
  fw-frequency
  fw-current
  fw-stability
  fw-flow
  fw-resonance
  fw-entropy
  fw-coherence
  fw-semantics
  fw-field
  fw-taste
  fw-consonance
  fw-sovereignty
)

# Collected failure lines — printed in both modes, and the ONLY output in quiet mode.
problems=()

say() {
  # Informational output. Suppressed entirely in quiet mode.
  if [ "$QUIET" -eq 0 ]; then
    echo "$@"
  fi
}

say "Facework doctor"
say "Repo: $ROOT_DIR"
say "Skills dir: $SKILL_DIR"
say

# A recorded canonical clone that isn't this one means the global skills belong to
# a different checkout. Running this doctor from the wrong clone would otherwise
# report every skill as broken without explaining why.
if [ -f "$MARKER" ]; then
  recorded="$(tr -d '[:space:]' < "$MARKER")"
  if [ -n "$recorded" ] && [ "$recorded" != "$ROOT_DIR" ]; then
    if [ -d "$recorded" ]; then
      problems+=("[canonical] global skills belong to $recorded, not this clone ($ROOT_DIR)")
      problems+=("            run the doctor from there, or: $ROOT_DIR/bin/install-skills --force")
    else
      problems+=("[canonical] recorded clone $recorded no longer exists")
      problems+=("            run: $ROOT_DIR/bin/install-skills")
    fi
  fi
else
  say "[note] no canonical marker yet — run bin/install-skills to record this clone."
  say
fi

for skill in "${REQUIRED[@]}"; do
  path="$SKILL_DIR/$skill"
  expected="$ROOT_DIR/skills/$skill"

  # -e follows symlinks, so a dangling link fails here — which is exactly the
  # failure Claude Code itself reports silently.
  if [ ! -e "$path" ]; then
    if [ -L "$path" ]; then
      problems+=("[broken] $skill -> $(readlink "$path") (target missing)")
    else
      problems+=("[missing] $skill")
    fi
    continue
  fi

  if [ ! -L "$path" ]; then
    problems+=("[noncanonical] $skill (exists but is not a symlink)")
    continue
  fi

  target="$(readlink "$path" || true)"
  if [ "$target" != "$expected" ]; then
    problems+=("[noncanonical] $skill -> $target (expected $expected)")
    continue
  fi

  say "[ok] $skill"
done

if [ "${#problems[@]}" -gt 0 ]; then
  say
  if [ "$QUIET" -eq 1 ]; then
    echo "Facework skills are not loadable — Claude Code will show no /fw-* commands."
  fi
  for line in "${problems[@]}"; do
    echo "$line"
  done
  echo "Fix: $ROOT_DIR/bin/install-skills"
  exit 1
fi

say
say "All required skills are installed."
exit 0
