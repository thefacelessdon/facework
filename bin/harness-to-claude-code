#!/usr/bin/env ruby
# frozen_string_literal: true

# harness-to-claude-code
#
# Convert a Facework HarnessBundle (PROTOCOL.md §10 — the derived markdown view
# of the Runtime Ports) into a runnable Claude Code / Agent SDK bundle.
#
# This is the first concrete HarnessBundle consumer, built after the fourth
# Runtime Ports validation (Claude Code) showed the bundle layout maps cleanly
# onto Claude Code's on-disk files. See:
#   methodology/runtime-ports-claude-code-gap-2026-08-05.md  (finding B)
#   PROTOCOL.md §10  (HarnessBundle spec + 0.0.22 validation note)
#
# Mapping (bundle -> Claude Code):
#   boundary/identity/soul/purpose/memory/tools .md  ->  CLAUDE.md (project memory)
#   skills/{id}.md                                   ->  .claude/skills/{id}/SKILL.md
#   tools.md (MCP servers)                           ->  .mcp.json + .claude/MCP-SETUP.md (scaffolds)
#   derived                                          ->  .claude/settings.json (permissions scaffold)
#
# One-way only (§10.6): the YAML manifests remain the source of truth. Secrets
# are NEVER emitted — the bundle excludes them by design, and so does this tool.
#
# Usage:
#   bin/harness-to-claude-code <bundle-dir> --out <dir> [--force]
#   bin/harness-to-claude-code examples/face.works/harness-bundle --out /tmp/fw-claude

require 'yaml'
require 'json'
require 'fileutils'
require 'optparse'

# Bundle files are UTF-8 (em dashes, arrows). System Ruby may default the
# external encoding to US-ASCII; force UTF-8 so reads/regex/writes are safe.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

# ---- args -------------------------------------------------------------------

options = { force: false }
parser = OptionParser.new do |o|
  o.banner = 'Usage: harness-to-claude-code <bundle-dir> --out <dir> [--force]'
  o.on('--out DIR', 'Output directory for the generated Claude Code bundle') { |v| options[:out] = v }
  o.on('--force', 'Overwrite the output directory if it already exists') { options[:force] = true }
  o.on('-h', '--help') { puts o; exit 0 }
end
parser.parse!

bundle_dir = ARGV[0]
abort "error: no bundle directory given\n\n#{parser}" if bundle_dir.nil?
abort "error: bundle directory not found: #{bundle_dir}" unless File.directory?(bundle_dir)
abort "error: not a HarnessBundle (no CLAUDE.md): #{bundle_dir}" unless File.file?(File.join(bundle_dir, 'CLAUDE.md'))
abort "error: --out is required" if options[:out].nil?

out_dir = options[:out]
if File.exist?(out_dir) && !options[:force]
  abort "error: output dir exists: #{out_dir} (use --force to overwrite)"
end

# ---- helpers ----------------------------------------------------------------

# Split a markdown file into [frontmatter_hash, body_string].
def split_frontmatter(text)
  if text =~ /\A---\s*\n(.*?)\n---\s*\n?(.*)\z/m
    fm = begin
      YAML.safe_load(Regexp.last_match(1), permitted_classes: [], aliases: false) || {}
    rescue StandardError
      {}
    end
    [fm, Regexp.last_match(2)]
  else
    [{}, text]
  end
end

def strip_leading_h1(body)
  body.sub(/\A\s*#\s+.*\n+/, '')
end

def first_paragraph(body)
  stripped = strip_leading_h1(body).strip
  para = stripped.split(/\n\s*\n/).first.to_s
  para.gsub(/\s+/, ' ').strip
end

def slugify(name)
  name.downcase.gsub(/\(.*?\)/, '').strip.gsub(/[^a-z0-9]+/, '-').gsub(/\A-|-\z/, '')
end

def read(bundle_dir, name)
  path = File.join(bundle_dir, name)
  File.file?(path) ? File.read(path) : nil
end

# ---- read bundle root -------------------------------------------------------

root_fm, = split_frontmatter(File.read(File.join(bundle_dir, 'CLAUDE.md')))
tenant   = root_fm['tenant'] || 'unknown-tenant'
track    = root_fm['track']
evidence = root_fm['evidence_level']
src_man  = root_fm['source_manifest']

# ---- compose CLAUDE.md ------------------------------------------------------

# Reading order per the bundle's own navigation (boundary first — it is the
# memory-boundary contract the runtime must respect before anything else).
SECTIONS = [
  ['boundary.md', 'Memory Boundary (read first)'],
  ['identity.md', 'Identity'],
  ['soul.md',     'Soul — Signal & Taste'],
  ['purpose.md',  'Purpose — Locked Direction'],
  ['memory.md',   'Memory Map'],
  ['tools.md',    'Tools & Integrations']
].freeze

claude_md = +""
claude_md << "# #{tenant} — Project Memory (generated from HarnessBundle)\n\n"
claude_md << "<!-- GENERATED by bin/harness-to-claude-code from a Facework HarnessBundle (PROTOCOL.md §10).\n"
claude_md << "     Source of truth: #{src_man || 'the Runtime Port YAML manifests'}.\n"
claude_md << "     Do NOT hand-edit — edit the source artifacts and regenerate (§10.6, one-way). -->\n\n"
claude_md << "- **Tenant:** #{tenant}\n"
claude_md << "- **Track:** #{track}\n" if track
claude_md << "- **Evidence level:** #{evidence}\n" if evidence
claude_md << "\n---\n\n"

SECTIONS.each do |file, label|
  content = read(bundle_dir, file)
  next if content.nil?

  claude_md << "## #{label}\n\n"
  claude_md << strip_leading_h1(content).strip
  claude_md << "\n\n---\n\n"
end

# ---- skills -----------------------------------------------------------------

skills_src = Dir.glob(File.join(bundle_dir, 'skills', '*.md')).sort
skills_written = []

skills_src.each do |path|
  fm, body = split_frontmatter(File.read(path))
  id = fm['id'] || File.basename(path, '.md')
  name = fm['name'] || id
  description = first_paragraph(body)
  if description.length > 200
    cut = description[0, 197]
    cut = cut[0, cut.rindex(' ') || 197].rstrip # break on a word boundary
    description = "#{cut}…"
  end

  # Claude Code SKILL.md frontmatter: name + description are the load-bearing
  # keys; carry the port-level fields through as extra keys for fidelity.
  fm_out = { 'name' => name, 'description' => description }
  %w[trigger ownership tags model_tier].each { |k| fm_out[k] = fm[k] unless fm[k].nil? }

  skill_md = +""
  skill_md << fm_out.to_yaml # includes leading '---'
  skill_md << "---\n\n"
  skill_md << body.strip
  skill_md << "\n"

  skills_written << { id: id, name: name }
  dest = File.join(out_dir, '.claude', 'skills', id)
  FileUtils.mkdir_p(dest)
  File.write(File.join(dest, 'SKILL.md'), skill_md)
end

# ---- MCP servers (parsed from tools.md — scaffold only) ---------------------

tools_md = read(bundle_dir, 'tools.md') || ''
mcp_servers = []
tools_md.scan(/^###\s+(.+?)\s*\(MCP server\)\s*$(.*?)(?=^###\s|\z)/m) do |name, block|
  slug = slugify(name)
  scope = block[/\*\*Scope:\*\*\s*(.+)/, 1]&.strip
  auth  = block[/\*\*Auth:\*\*\s*(.+)/, 1]&.strip
  mcp_servers << { slug: slug, name: name.strip, scope: scope, auth: auth }
end

mcp_json = { 'mcpServers' => {} }
mcp_servers.each do |s|
  # Endpoints/commands and secrets are NOT in the bundle by design. Emit a
  # valid, clearly-marked placeholder the operator fills from their own config.
  mcp_json['mcpServers'][s[:slug]] = {
    'command' => 'TODO-REPLACE',
    'args' => [],
    'env' => {}
  }
end

# ---- settings.json (permissions scaffold) -----------------------------------

allow = mcp_servers.map { |s| "mcp__#{s[:slug]}" }
settings = {
  '$schema' => 'https://json.schemastore.org/claude-code-settings.json',
  '_generated_by' => 'facework bin/harness-to-claude-code',
  'permissions' => { 'allow' => allow, 'ask' => [], 'deny' => [] }
}

# ---- write structured outputs -----------------------------------------------

FileUtils.mkdir_p(File.join(out_dir, '.claude'))
File.write(File.join(out_dir, 'CLAUDE.md'), claude_md)
File.write(File.join(out_dir, '.mcp.json'), JSON.pretty_generate(mcp_json) + "\n")
File.write(File.join(out_dir, '.claude', 'settings.json'), JSON.pretty_generate(settings) + "\n")

# Human-readable MCP setup guide (secrets excluded, auth *references* only).
setup = +"# MCP Setup (fill in before use)\n\n"
setup << "Generated from the HarnessBundle `tools.md`. The bundle excludes secret\n"
setup << "values by design; `.mcp.json` ships placeholder commands. For each server\n"
setup << "below, set the real transport (`command`/`args` or `type`/`url`) in\n"
setup << "`.mcp.json`, and resolve auth from your own secret store — never commit secrets.\n\n"
if mcp_servers.empty?
  setup << "_No MCP servers found in tools.md._\n"
else
  mcp_servers.each do |s|
    setup << "## #{s[:name]} (`#{s[:slug]}`)\n\n"
    setup << "- Scope: #{s[:scope] || 'n/a'}\n"
    setup << "- Auth (reference only): #{s[:auth] || 'n/a'}\n\n"
  end
end
File.write(File.join(out_dir, '.claude', 'MCP-SETUP.md'), setup)

# ---- summary ----------------------------------------------------------------

puts "Converted HarnessBundle -> Claude Code bundle"
puts "  bundle:  #{bundle_dir}"
puts "  out:     #{out_dir}"
puts "  tenant:  #{tenant}#{track ? " (#{track})" : ''}"
puts "  CLAUDE.md:        #{SECTIONS.count { |f, _| read(bundle_dir, f) }} sections composed"
puts "  .claude/skills/:  #{skills_written.size} skills (#{skills_written.map { |s| s[:id] }.join(', ')})"
puts "  .mcp.json:        #{mcp_servers.size} servers (scaffold — endpoints/secrets TODO)"
puts "  settings.json:    #{allow.size} permission allow-rules"
puts ""
puts "Next: fill .mcp.json endpoints + auth per .claude/MCP-SETUP.md, then run Claude Code in #{out_dir}."
