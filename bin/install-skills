#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SKILL_DIR="$HOME/.claude/skills"
BACKUP_ROOT="$SKILL_DIR/.facework-backups"
RUN_ID="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="$BACKUP_ROOT/$RUN_ID"

mkdir -p "$SKILL_DIR"
mkdir -p "$BACKUP_ROOT"

MARKER="$SKILL_DIR/.facework-canonical"
HOOK_DEST="$HOME/.claude/facework-session-check.sh"

FORCE=0
if [ "${1:-}" = "--force" ]; then
  FORCE=1
fi

# The global skill namespace can only belong to one clone. Without this guard any
# project-local copy of Facework silently repoints every /fw-* skill at itself —
# which is how a stale v0.0.3 checkout ended up owning the namespace once already.
if [ -f "$MARKER" ]; then
  RECORDED="$(tr -d '[:space:]' < "$MARKER")"
  if [ -n "$RECORDED" ] && [ "$RECORDED" != "$ROOT_DIR" ]; then
    if [ -d "$RECORDED" ] && [ "$FORCE" -ne 1 ]; then
      echo "Refusing to install: the global Facework skills belong to another clone."
      echo
      echo "  canonical : $RECORDED"
      echo "  this clone: $ROOT_DIR"
      echo
      echo "Install from the canonical clone instead, or make this one canonical with:"
      echo "  $ROOT_DIR/bin/install-skills --force"
      exit 1
    fi
    # Recorded clone is gone (moved/deleted), or --force was passed: adopt this one.
    echo "Adopting $ROOT_DIR as the canonical Facework clone (was $RECORDED)."
    echo
  fi
fi


SKILLS=(
  fw-frequency
  fw-current
  fw-stability
  fw-flow
  fw-resonance
  fw-entropy
  fw-coherence
  fw-semantics
  fw-field
  fw-taste
  fw-consonance
  fw-sovereignty
  mvp-cut
  beta-hardening
  scale-readiness
  contract-sync
  decision-log
  weekly-upgrade
  evidence-debug
  launch-ops
  runtime-validation-pass
  fw-spectrum
  harness-open
  harness-review
  harness-close
)

PRIMITIVES=(
  fw-frequency
  fw-current
  fw-stability
  fw-flow
  fw-resonance
  fw-entropy
  fw-coherence
  fw-semantics
  fw-field
  fw-taste
  fw-consonance
  fw-sovereignty
)

is_primitive() {
  local candidate="$1"
  for primitive in "${PRIMITIVES[@]}"; do
    if [ "$primitive" = "$candidate" ]; then
      return 0
    fi
  done
  return 1
}

backup_path() {
  local dst_path="$1"
  local skill_name="$2"
  mkdir -p "$BACKUP_DIR"
  mv "$dst_path" "$BACKUP_DIR/$skill_name"
  echo "[backup] $dst_path -> $BACKUP_DIR/$skill_name"
}

INSTALL_COMPLETE=0

# A run killed partway through (SIGPIPE from `| head`, Ctrl-C) can leave a skill
# backed up but not yet relinked — i.e. missing rather than merely stale. Say so
# instead of exiting quietly into a half-installed namespace.
ABORT_REPORTED=0
report_abort() {
  status=$?
  # EXIT and PIPE can both fire for one interruption — report once.
  if [ "$INSTALL_COMPLETE" -eq 0 ] && [ "$ABORT_REPORTED" -eq 0 ]; then
    ABORT_REPORTED=1
    # stderr, not stdout: the usual cause is a closed stdout pipe (`| head`).
    echo >&2
    echo "[abort] install did not finish (exit $status) — the skill set may be half-linked." >&2
    echo "        Re-run: $ROOT_DIR/bin/install-skills" >&2
    if [ -d "$BACKUP_DIR" ]; then
      echo "        Backups from this run: $BACKUP_DIR" >&2
    fi
  fi
}
trap report_abort EXIT INT TERM PIPE

echo "Installing Facework skills to $SKILL_DIR"

for skill in "${SKILLS[@]}"; do
  src="$ROOT_DIR/skills/$skill"
  dst="$SKILL_DIR/$skill"

  if [ ! -d "$src" ]; then
    echo "[warn] missing source: $src"
    continue
  fi

  if [ -L "$dst" ]; then
    target="$(readlink "$dst" || true)"
    if [ "$target" = "$src" ]; then
      if is_primitive "$skill"; then
        echo "[ok] $skill (already canonical)"
      else
        echo "[ok] $skill (already linked)"
      fi
      continue
    fi
    backup_path "$dst" "$skill"
  elif [ -e "$dst" ]; then
    backup_path "$dst" "$skill"
  fi

  ln -s "$src" "$dst"
  if is_primitive "$skill"; then
    echo "[ok] $skill (canonicalized)"
  else
    echo "[ok] $skill"
  fi
done

echo
if [ -d "$BACKUP_DIR" ]; then
  echo "Backups stored at: $BACKUP_DIR"
else
  echo "No backups were needed."
fi
printf '%s\n' "$ROOT_DIR" > "$MARKER"
echo "Canonical clone recorded: $MARKER"

# Copied, not symlinked: the hook must still run when this clone is what vanished.
if cp "$ROOT_DIR/bin/facework-session-check" "$HOOK_DEST" 2>/dev/null; then
  chmod +x "$HOOK_DEST"
  echo "Session hook copied: $HOOK_DEST"
  # Copying is not installing. Claude Code only fires a hook that is declared in a
  # settings.json hooks block, so registration is a separate, required step.
  "$ROOT_DIR/bin/facework-register-hook"
else
  echo "[warn] could not copy session hook to $HOOK_DEST — hook not installed"
fi

INSTALL_COMPLETE=1
echo "Installed Facework skills."
echo "Run: $ROOT_DIR/bin/facework-doctor"
